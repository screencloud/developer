{
  "name": "@screencloud/apps-sdk",
  "version": "1.2.2",
  "description": "Vanilla JavaScript SDK for building ScreenCloud apps",
  "keywords": [
    "screencloud",
    "apps",
    "javascript",
    "typescript"
  ],
  "author": "Michael Martin <michael@screencloud.io>",
  "homepage": "https://screencloud.github.io/developer/",
  "license": "ISC",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/screencloud/developer.git"
  },
  "bugs": {
    "url": "https://github.com/screencloud/developer/issues"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsc --watch",
    "lint": "prettier --check --no-config 'src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}' && eslint 'src/**/*.{ts,tsx,js,jsx}'",
    "lint:fix": "prettier --write --no-config 'src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}' && eslint --fix 'src/**/*.{ts,tsx,js,jsx}'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "browserslist": "> 0.25%, not dead",
  "publishConfig": {
    "access": "public"
  }
}
