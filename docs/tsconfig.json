{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "$components": ["./src/components/index"]
    }
  },
  "include": ["src", "config.ts", "gatsby-browser.ts", "gatsby-config.ts", "gatsby-node.ts"]
}
